# ──────────────────────────────
# Cargo / Rust
# ──────────────────────────────
/target/
**/*.rs.bk
Cargo.lock
# (Keep Cargo.lock if this is an application, not a library)
# Uncomment if this is a binary-only repo:
# !Cargo.lock

# ──────────────────────────────
# Build & Tooling artifacts
# ──────────────────────────────
**/*.d
**/*.o
**/*.rlib
**/*.rmeta
**/*.so
**/*.a
**/*.dll
**/*.exe
**/*.bin
**/*.elf
**/*.hex
**/*.map

# Rust analyzer / Clippy / etc.
*.profraw
*.profdata

# ──────────────────────────────
# IDE / Editor specific
# ──────────────────────────────

# VS Code
.vscode/
.vscode-test/

# JetBrains CLion / IntelliJ
.idea/
cmake-build-*/
*.iml

# Eclipse / other IDEs
.project
.cproject
.settings/

# ──────────────────────────────
# Probe-rs / Embedded tools
# ──────────────────────────────
# probe-rs temporary files
.probe-rs/
*.defmt
*.svd2rust
*.log

# OpenOCD / GDB
.gdb_history

# Firmware build outputs
*.elf
*.bin
*.hex
*.map

# ──────────────────────────────
# OS / Miscellaneous
# ──────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Temporary files
*.tmp
*.swp
*.swo
*.bak
*.old

# ──────────────────────────────
# Documentation / Generated
# ──────────────────────────────
/doc/
/target/doc/
/*.pdf
/*.svg
